# Server-side configuration. Never prefix these with NEXT_PUBLIC_, and never
# commit real values: supply them from the deployment's secret store, or a
# local, uncommitted .env.

# --- Registry dashboard services (one per registry) ---
# Base URL of each registry's dashboard API, as reachable from this server.
FARMER_REGISTRY_DASHBOARD_API_URL=http://localhost:8005
LIVESTOCK_REGISTRY_DASHBOARD_API_URL=http://localhost:8006
CROPSOWN_REGISTRY_DASHBOARD_API_URL=http://localhost:8007

# --- Access to Credit ---
# Base URL of the A2C platform (the Frappe site), which serves the A2C charts.
# The Access to Credit dashboard is offered only when this is set.
A2C_DASHBOARD_API_URL=http://localhost:8000
# Path of its charts under that URL. Default /api/v1/charts (Frappe directly);
# set /v1/charts when the URL is A2C's Kong gateway.
# A2C_DASHBOARD_API_CHARTS_PATH=/api/v1/charts

# --- Grievance Redress ---
# Base URL of the grievance service (its Frappe site), which serves the grievance
# charts at /api/v1/charts. The Grievance Redress dashboard is offered only when set.
# GRIEVANCE_DASHBOARD_API_URL=http://localhost:8000

# --- Gateway API keys ---
# Sent as the `apikey` header once a service's Kong gateway enforces auth
# (consumer oan-dashboards). Leave unset for a local bench.
# A2C_DASHBOARD_API_KEY=
# GRIEVANCE_DASHBOARD_API_KEY=

# Seconds a service response is cached before the service is called again.
DASHBOARD_CACHE_TTL_SECONDS=900

# --- Transitional: direct database access ---
# Used only by dashboards whose data is not yet served by a dashboard service
# (catalogs, devops, and some registry panels). Removed once
# those move to services. Format: postgres://<user>:<password>@<host>:5432/<db>
DATABASE_URL=
FARMER_DATABASE_URL=
